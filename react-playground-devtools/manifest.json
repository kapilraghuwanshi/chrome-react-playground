{
  "manifest_version": 3,
  "name": "React Playground - DevTools",
  "version": "1.0",
  "description": "Write JSX in DevTools and run safely inside a sandboxed iframe.",
  "author": "Tech Monk-Kapil",
  "homepage_url": "https://github.com/kapilraghuwanshi/chrome-react-playground",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "devtools_page": "devtools.html",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*.js", "iframe.html", "iframe.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
