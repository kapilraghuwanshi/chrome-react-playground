{
  "manifest_version": 3,
  "name": "React Playground - DevTools",
  "version": "1.0",
  "description": "Write JSX in DevTools and run safely inside a sandboxed iframe.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "devtools_page": "devtools.html",
  "permissions": ["storage"],
  "host_permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["vendor/*.js", "iframe.html", "iframe.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
